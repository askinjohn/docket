# Copy to apps/core/.env and fill in values from Google Cloud Console.
# Never commit .env

LOCAL_MAIL_CORE_HOST=127.0.0.1
LOCAL_MAIL_CORE_PORT=8787
LOCAL_MAIL_WEB_ORIGIN=http://127.0.0.1:4300

# Optional: override default ~/.local-mail
# LOCAL_MAIL_DATA_DIR=/path/to/data

# Google OAuth Desktop / Web client (loopback redirect)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match authorized redirect URI in Google Cloud
GOOGLE_REDIRECT_URI=http://127.0.0.1:8787/auth/gmail/callback

# Optional: notes folder for daily summary markdown
# LOCAL_MAIL_NOTES_DIR=/path/to/notes

# Optional AI (template fallback if unset)
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.2
# OPENAI_API_KEY=
# LOCAL_MAIL_AI_PROVIDER=template|ollama|openai
