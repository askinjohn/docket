# Copy to apps/core/.env and fill in values from Google Cloud Console.
# Never commit .env
#
# DOCKET_* is the current prefix. LOCAL_MAIL_* is still accepted.

DOCKET_CORE_HOST=127.0.0.1
DOCKET_CORE_PORT=8787
DOCKET_WEB_ORIGIN=http://127.0.0.1:4300

# Optional: override default ~/.docket (existing ~/.local-mail is reused if present)
# DOCKET_DATA_DIR=/path/to/data

# OAuth token storage (configure after clone):
#   sqlite   — default; access/refresh tokens in mail.sqlite (simple dogfood)
#   keychain — macOS Keychain / Windows Credential Manager / libsecret (via keytar)
#              Recommended for daily use. Requires: cd apps/core && npm install keytar
DOCKET_TOKEN_STORE=sqlite

# Google OAuth Desktop / Web client (loopback redirect)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match authorized redirect URI in Google Cloud
GOOGLE_REDIRECT_URI=http://127.0.0.1:8787/auth/gmail/callback

# Optional: notes folder for daily summary markdown
# DOCKET_NOTES_DIR=/path/to/notes

# Background inbox poll + macOS notify (works with the window closed)
# DOCKET_BG_SYNC_MS=30000
# DOCKET_OS_NOTIFY=1

# AI config file (Grist-style backends + roles). Created on first run:
#   ~/.docket/ai-config.json
# DOCKET_AI_CONFIG=/custom/path/ai-config.json
# OPENAI_API_KEY=   # used when a role's backend has apiKeyEnv=OPENAI_API_KEY
