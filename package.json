{
  "name": "local-mail",
  "version": "0.0.1",
  "private": true,
  "description": "Local-first Gmail client — Angular 22 UI + local core",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "web:start": "npm --prefix apps/web start -- --host 127.0.0.1 --port 4200",
    "web:build": "npm --prefix apps/web run build",
    "web:test": "npm --prefix apps/web test -- --watch=false",
    "web:install": "npm --prefix apps/web install",
    "core:dev": "npm --prefix apps/core run dev",
    "core:start": "npm --prefix apps/core start",
    "core:install": "npm --prefix apps/core install",
    "desktop:dev": "npm --prefix apps/desktop run dev",
    "desktop:build": "npm --prefix apps/desktop run build",
    "desktop:install": "npm --prefix apps/desktop install",
    "install:all": "npm --prefix apps/web install && npm --prefix apps/core install && npm --prefix apps/desktop install"
  }
}
